{
  "info": {
    "name": "Fuel Stop Planner",
    "description": "Plans a driving route between two places in the USA and the cheapest fuel stops for a vehicle with a 500-mile range that does 10 mpg.\n\nRun the server (`make run`), then run the collection. Every request has tests; trip requests also add a Visualize tab with the route and its stops.\n\nSet `baseUrl` if the server isn't on http://127.0.0.1:8000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs after every request in the collection.",
          "const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
          "",
          "if (pm.response.code === 200 && contentType.includes(\"application/json\")) {",
          "  const plan = pm.response.json();",
          "",
          "  pm.test(\"Stop costs add up to the total\", () => {",
          "    const sum = plan.fuel_stops.reduce((total, stop) => total + stop.cost, 0);",
          "    pm.expect(sum).to.be.closeTo(plan.summary.total_cost, 0.005);",
          "  });",
          "  pm.test(\"Every gallon the trip burns is bought (miles / mpg)\", () => {",
          "    const needed = plan.route.distance_miles / plan.summary.miles_per_gallon;",
          "    pm.expect(plan.summary.total_gallons).to.be.closeTo(needed, 0.05);",
          "  });",
          "  pm.test(\"No stop buys more than a full tank\", () => {",
          "    const tank = plan.summary.range_miles / plan.summary.miles_per_gallon;",
          "    plan.fuel_stops.forEach((stop) => pm.expect(stop.gallons).to.be.at.most(tank));",
          "  });",
          "  pm.test(\"Each cost is gallons x price\", () => {",
          "    plan.fuel_stops.forEach((stop) =>",
          "      pm.expect(stop.cost).to.be.closeTo(stop.gallons * stop.price_per_gallon, 0.0051));",
          "  });",
          "",
          "  // Visualize tab: the route and its stops, drawn without map tiles.",
          "  const width = 640, height = 360, pad = 24;",
          "  const points = plan.route.geometry.coordinates;",
          "  const lngs = points.map((p) => p[0]), lats = points.map((p) => p[1]);",
          "  const minLng = Math.min(...lngs), maxLng = Math.max(...lngs);",
          "  const minLat = Math.min(...lats), maxLat = Math.max(...lats);",
          "  const xScale = Math.cos(((minLat + maxLat) / 2) * Math.PI / 180);",
          "  const scale = Math.min((width - 2 * pad) / ((maxLng - minLng) * xScale || 1),",
          "                         (height - 2 * pad) / ((maxLat - minLat) || 1));",
          "  const project = (lng, lat) => [pad + (lng - minLng) * xScale * scale, height - pad - (lat - minLat) * scale];",
          "  const route = points.map((p) => project(p[0], p[1]).map((v) => v.toFixed(1)).join(\",\")).join(\" \");",
          "  const stops = plan.fuel_stops.map((stop) => {",
          "    const [x, y] = project(stop.station.longitude, stop.station.latitude);",
          "    return Object.assign({ x: x.toFixed(1), y: y.toFixed(1) }, stop);",
          "  });",
          "  const [startX, startY] = project(plan.start.longitude, plan.start.latitude);",
          "  const [finishX, finishY] = project(plan.finish.longitude, plan.finish.latitude);",
          "",
          "  pm.visualizer.set(`",
          "    <style>",
          "      body { font: 13px system-ui, sans-serif; color: #1d2433; }",
          "      table { border-collapse: collapse; margin-top: 12px; }",
          "      td, th { padding: 4px 10px; border-bottom: 1px solid #e3e7ee; text-align: left; }",
          "      .num { text-align: right; }",
          "    </style>",
          "    <h3>{{plan.start.label}} &rarr; {{plan.finish.label}}</h3>",
          "    <p>{{plan.route.distance_miles}} miles &middot; {{plan.summary.stop_count}} stops &middot;",
          "       {{plan.summary.total_gallons}} gal &middot; <b>\\${{plan.summary.total_cost}}</b></p>",
          "    <svg width=\"{{width}}\" height=\"{{height}}\" style=\"background:#f6f8fb;border:1px solid #e3e7ee;border-radius:8px\">",
          "      <polyline points=\"{{route}}\" fill=\"none\" stroke=\"#0b6bcb\" stroke-width=\"3\"/>",
          "      <circle cx=\"{{startX}}\" cy=\"{{startY}}\" r=\"6\" fill=\"#2b8a3e\"/>",
          "      <circle cx=\"{{finishX}}\" cy=\"{{finishY}}\" r=\"6\" fill=\"#c92a2a\"/>",
          "      {{#each stops}}",
          "        <circle cx=\"{{x}}\" cy=\"{{y}}\" r=\"9\" fill=\"#e8590c\" stroke=\"#fff\" stroke-width=\"2\"/>",
          "        <text x=\"{{x}}\" y=\"{{y}}\" dy=\"4\" text-anchor=\"middle\" font-size=\"10\" fill=\"#fff\">{{sequence}}</text>",
          "      {{/each}}",
          "    </svg>",
          "    <table>",
          "      <tr><th>#</th><th>Station</th><th>Where</th><th class=\"num\">Gallons</th><th class=\"num\">Price</th><th class=\"num\">Cost</th></tr>",
          "      {{#each stops}}",
          "        <tr><td>{{sequence}}</td><td>{{station.name}}</td>",
          "            <td>{{station.city}}, {{station.state}} &middot; {{#if departure}}before setting off{{else}}mile {{route_mile}}{{/if}}</td>",
          "            <td class=\"num\">{{gallons}}</td><td class=\"num\">\\${{price_per_gallon}}</td><td class=\"num\">\\${{cost}}</td></tr>",
          "      {{/each}}",
          "    </table>",
          "    {{#each plan.notes}}<p><i>{{this}}</i></p>{{/each}}",
          "  `, { plan, route, stops, width, height, startX, startY, finishX, finishY });",
          "}",
          "",
          "if (pm.response.code >= 400 && pm.response.code !== 429) {",
          "  pm.test(\"Errors are problem details\", () => {",
          "    pm.expect(contentType).to.eql(\"application/problem+json\");",
          "    pm.expect(pm.response.json()).to.include.all.keys(\"type\", \"title\", \"status\", \"code\", \"detail\");",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Trips",
      "item": [
        {
          "name": "Chicago to Houston (city and state)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trips/plan/?start=Chicago, IL&finish=Houston, TX",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "trips",
                "plan",
                ""
              ],
              "query": [
                {
                  "key": "start",
                  "value": "Chicago, IL"
                },
                {
                  "key": "finish",
                  "value": "Houston, TX"
                }
              ]
            },
            "description": "The everyday case: two towns given as 'City, ST', looked up locally, so the only external call is the route."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const plan = pm.response.json();",
                  "pm.test(\"Starts with the fill-up before setting off\", () => pm.expect(plan.fuel_stops[0].departure).to.be.true);",
                  "pm.test(\"Stops are in route order\", () => {",
                  "  const miles = plan.fuel_stops.map((stop) => stop.route_mile);",
                  "  pm.expect(miles).to.eql([...miles].sort((a, b) => a - b));",
                  "});",
                  "pm.test(\"Server-Timing shows where the time went\", () => pm.expect(pm.response.headers.get(\"Server-Timing\")).to.include(\"route;dur=\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "New York to Los Angeles (coast to coast)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trips/plan/?start=New York, NY&finish=Los Angeles, CA",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "trips",
                "plan",
                ""
              ],
              "query": [
                {
                  "key": "start",
                  "value": "New York, NY"
                },
                {
                  "key": "finish",
                  "value": "Los Angeles, CA"
                }
              ]
            },
            "description": "About 2,800 miles: at least six fill-ups for a 500-mile range."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const plan = pm.response.json();",
                  "pm.test(\"Enough stops for a 500-mile range\", () =>",
                  "  pm.expect(plan.summary.stop_count).to.be.at.least(Math.ceil(plan.route.distance_miles / 500)));",
                  "pm.test(\"No stretch between stops is longer than the range\", () => {",
                  "  const miles = [0, ...plan.fuel_stops.slice(1).map((stop) => stop.route_mile), plan.route.distance_miles];",
                  "  for (let i = 1; i < miles.length; i++) pm.expect(miles[i] - miles[i - 1]).to.be.at.most(500);",
                  "});"
                ]
              }
            }
          ]
        },
